            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "{{api_key}}"
          }
        ],
        "responses": {},
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "invoice_no": {
                    "type": "string"
                  },
                  "customer_name": {
                    "type": "string"
                  },
                  "payment_method": {
                    "type": "string"
                  },
                  "subtotal": {
                    "type": "integer"
                  },
                  "tax": {
                    "type": "integer"
                  },
                  "discount": {
                    "type": "integer"
                  },
                  "grand_total": {
                    "type": "integer"
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "product_id": {
                          "type": "integer"
                        },
                        "product_name": {
                          "type": "string"
                        },
                        "price": {
                          "type": "integer"
                        },
                        "quantity": {
                          "type": "integer"
                        },
                        "total": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              },
              "example": {
                "invoice_no": "INV-1234",
                "customer_name": "John Doe",
                "payment_method": "card",
                "subtotal": 80,
                "tax": 8,
                "discount": 0,
                "grand_total": 88,
                "items": [
                  {
                    "product_id": 1,
                    "product_name": "Widget",
                    "price": 40,
                    "quantity": 2,
                    "total": 80
                  }
                ]
              }
            }
          }
        }
